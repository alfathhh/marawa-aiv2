# Identity and public links
APP_NAME="MARAWA AI — Asisten Statistik Padang Pariaman"
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
TZ=Asia/Jakarta
OFFICIAL_WEBSITE_URL=https://padangpariamankab.bps.go.id
OFFICIAL_PPID_URL=https://ppid.bps.go.id/?mfd=1306
BPS_DOMAIN=1306
BPS_SIMDASI_REGION=1306000
PUBLIC_FORM_URL=
SKD_URL=https://skd.bps.go.id/skd/p/1306

# LLM routing — exact model IDs must be capability-probed
PRIMARY_PROVIDER=gemini
PRIMARY_MODEL=
PRIMARY_API_BASE=
PRIMARY_API_KEY_FILE=
FALLBACK_PROVIDER=deepseek
FALLBACK_MODEL=deepseek-v4-flash
FALLBACK_API_BASE=https://api.deepseek.com
FALLBACK_API_KEY_FILE=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY_FILE=
LLM_TIMEOUT_SECONDS=20
MAX_AGENT_STEPS=8
MAX_AGENT_WALL_SECONDS=45
ANALYSIS_JOB_TIMEOUT_SECONDS=120
ANALYSIS_MAX_MEMORY_MB=512
ANALYSIS_MAX_OUTPUT_BYTES=52428800

# Databases and queue
APP_DATABASE_URL=postgresql+asyncpg://marawa_app:change-me@postgres:5432/marawa
SOURCE_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
BPS_API_KEY_FILE=
BPS_HTTP_PROXY_FILE=
BPS_PUBLICATION_STORE_PATH=/data/bps-publications
BPS_PUBLICATION_DISK_RESERVE_GIB=5
BPS_MIN_DELAY=0.5
BPS_MAX_DELAY=1.0

# Internal webhook/session encryption
WEBHOOK_CURRENT_SECRET_FILE=
WEBHOOK_PREVIOUS_SECRET_FILE=
WEBHOOK_MAX_SKEW_SECONDS=300
PII_ENCRYPTION_KEY_FILE=
SESSION_SIGNING_KEY_FILE=
TOTP_WRAPPING_KEY_FILE=
WA_STATE_ENCRYPTION_KEY_FILE=

# Channel
WA_ACCOUNT_ID=marawa-main
WA_ENABLE_GROUPS=false
WA_ENABLE_MEDIA=false
WA_MAX_MEDIA_BYTES=10485760

# Conversation/handover
SESSION_INACTIVITY_MINUTES=30
BOT_COOLDOWN_SECONDS=0
HANDOVER_SLA_TEXT=
MAX_ROWS_WHATSAPP=10

# Operations
LOG_LEVEL=INFO
ENABLE_PROMPT_PAYLOAD_LOGGING=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Runtime API (scripts/app.py / systemd marawa-api)
# mode produksi EKSPLISIT; tanpa ini mode dev aktif dan X-Admin-Id diterima
MARAWA_ENV=production
MARAWA_RUNTIME_DSN=postgresql://marawa_runtime_rw:change-me@127.0.0.1:55432/marawa
MARAWA_SESSION_KEY=change-me-32-bytes
MARAWA_WEBHOOK_SECRET=change-me
MARAWA_INTERNAL_KEY=change-me
MARAWA_LLM_MODEL=gemini-3.5-flash-lite
MARAWA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

